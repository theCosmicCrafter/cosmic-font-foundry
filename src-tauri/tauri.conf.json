{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cosmic Font Foundry",
  "version": "0.3.0",
  "identifier": "com.thecosmiccrafter.cosmicfontfoundry",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://www.fontsquirrel.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' data: blob: asset: http://asset.localhost https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdn.fontshare.com; connect-src ipc: http://ipc.localhost https://api.fontsource.org https://api.fontshare.com https://cdn.jsdelivr.net https://cdn.fontshare.com https://www.fontsquirrel.com http://localhost:11434 http://127.0.0.1:11434 http://127.0.0.1:17420",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Cosmic Font Foundry",
    "homepage": "https://github.com/theCosmicCrafter/cosmic-font-foundry",
    "copyright": "Copyright (c) 2026 Cosmic Font Foundry",
    "category": "Utility",
    "shortDescription": "Local-first font manager for Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../licenses/*": "licenses/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_TAURI_SIGNING_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/theCosmicCrafter/cosmic-font-foundry/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
